# Copy to .env and fill in to exercise the LLM disambiguation path locally
# (npm run generate / npm run selfcheck auto-load .env if present; see package.json).
# Without these set, the generator still runs fine -- it just skips straight to the
# heuristic-only result, same as CI does.

OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=openai/gpt-4o
