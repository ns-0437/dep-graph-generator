{
  "name": "composio-dep-graph-generator",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "node --env-file-if-exists=.env --import tsx src/generate.ts",
    "selfcheck": "node --env-file-if-exists=.env --import tsx src/selfcheck.ts",
    "typecheck": "tsc",
    "test": "node --import tsx --test src/lib/*.test.ts src/*.test.ts",
    "coverage": "node --import tsx --test --experimental-test-coverage src/lib/*.test.ts src/*.test.ts"
  },
  "dependencies": {
    "openai": "^6.48.0"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "@types/node": "^22.10.0"
  }
}
